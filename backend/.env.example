# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:3000
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Tweet fetching
MASA_API_TOKEN=

# Classifier served on RunPod (serverless endpoint)
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# Reports + counselor chat (Gemini Flash via OpenRouter, called through LiteLLM)
OPENROUTER_API_KEY=

# Voice (text-to-speech and speech-to-text)
ELEVENLABS_API_KEY=
